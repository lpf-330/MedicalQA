    max_size=1,
    min_idle=1,
    idle_timeout=600000,
    max_wait_time=30000,
    allow_dynamic_creation=False,     # 模型创建成本高，禁止动态创建
    max_pending_requests=10,          # 较小的等待队列
    pre_create_check_enabled=True,    # 启用创建前检查
