    max_size=1,
    min_idle=1,
    idle_timeout=600000,
    max_wait_time=10000,
    allow_dynamic_creation=False,     # 禁止动态创建
    max_pending_requests=20,          # 较大的等待队列
    pre_create_check_enabled=True,
    min_memory_mb=1024,               # 向量模型较小
    min_vram_mb=2048                  # 向量模型显存需求较小
